@@ -246,6 +250,8 @@ static const struct rzg2l_csi2_format rzg2l_csi2_formats[] = {
 	  .rate = RATE_RANGES(80, 5238)},
 	{ .code = MEDIA_BUS_FMT_RGB888_1X24,	.bpp = 24,
 	  .rate = RATE_RANGES(80, 6000)},
