 	},
 	{
 		.width = 1280,
@@ -733,7 +765,8 @@ static const struct ov5645_mode_info ov5645_mode_info_data[] = {
 		.data = ov5645_setting_sxga,
 		.data_size = ARRAY_SIZE(ov5645_setting_sxga),
