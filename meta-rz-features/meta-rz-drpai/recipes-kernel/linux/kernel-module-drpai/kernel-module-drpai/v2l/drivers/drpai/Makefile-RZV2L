# Makefile for DRP-AI/DRP.
#
ccflags-y += -Werror
ccflags-y += -DDRPAI_CONFIG_ARCH_RZV2L

obj-m += drpai.o
drpai-objs := drpai-core.o drpai-if.o

SRC := $(shell pwd)
all:
	$(MAKE) -C $(KERNEL_SRC) M=$(SRC) modules

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(SRC) clean
